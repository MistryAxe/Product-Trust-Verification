{
  "name": "product-trust-verification-react-native",
  "version": "20.22.3",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "validate-project": "node scripts/validate-project.mjs",
    "start:go": "expo start --go",
    "start:web": "expo start --web",
    "deploy:functions": "firebase deploy --only functions",
    "build-web": "expo export --platform web",
    "deploy:web": "expo export --platform web && node scripts/prepare-web-deploy.mjs && npx firebase-tools deploy --only hosting --project product-trust-verification",
    "deploy:recall": "npx wrangler deploy --config workers/recall-lookup/wrangler.toml",
    "build:android": "npx eas-cli build --platform android --profile preview",
    "update:production": "npx eas-cli update --channel production",
    "update:preview": "npx eas-cli update --channel preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "barcode-detector": "^3.0.0",
    "expo": "^58.0.0",
    "expo-camera": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.18",
    "expo-print": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "expo-updates": "~58.0.19"
  },
  "devDependencies": {}
}
