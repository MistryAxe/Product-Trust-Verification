rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /report-evidence/{userId}/{allPaths=**} {
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if signedIn() && request.auth.uid == userId;
    }

    match /ingredient-labels/{userId}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == userId
        && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }

    match /product-images/{manufacturerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == manufacturerId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
